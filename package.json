{
    "name": "sweet-calc",
    "private": true,
    "version": "1.0.3",
    "type": "module",
    "description": "Sweet Calc — офлайн-калькулятор себестоимости, техкарт и КБЖУ кондитерских изделий",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
