        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vite-pwa/assets-generator": "^0.2.6",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.6.3",
        "typescript-eslint": "^8.18.0",
